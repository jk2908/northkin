{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"allowSyntheticDefaultImports": true,
		"skipLibCheck": true,
		"noEmit": true,
		"paths": {
			"#/*": ["./*"]
		},
		"types": ["vite/client", "bun", "@vitejs/plugin-rsc/types"]
	},
	"include": ["app", "lib", ".solas/*", ".cloudflare/types", ".cxx/*"]
}
