{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 90,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": false,
	"arrowParens": "avoid",
	"bracketSameLine": true,
	"bracketSpacing": true,
	"singleAttributePerLine": false,
	"sortImports": {
		"newlinesBetween": true,
		"internalPattern": ["#/"],
		"customGroups": [
			{
				"groupName": "react",
				"elementNamePattern": ["react", "react/**", "react-dom", "react-dom/**"]
			},
			{
				"groupName": "solas",
				"elementNamePattern": ["@jk2908/solas", "@jk2908/solas/**"]
			},
			{
				"groupName": "types",
				"selector": "type"
			}
		],
		"groups": [
			"react",
			"solas",
			"types",
			["builtin", "external"],
			["internal", "parent", "sibling", "index"],
			["side_effect", "style"],
			"unknown"
		]
	},
	"ignorePatterns": [
		"**/dist/**",
		"**/node_modules/**",
		"**/.cxx/**",
		"**/.solas/**",
		"**/build/**"
	]
}
